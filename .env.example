# Copy this file to .env and fill in your API key(s).
# Get a Gemini key at: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=your-key-here

# Optional: only needed if using OpenAI models (--model gpt-4o)
# OPENAI_API_KEY=your-key-here

# Optional: only needed if using a local Ollama model at a non-default URL
# OLLAMA_URL=http://localhost:11434
